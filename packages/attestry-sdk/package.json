{
  "name": "@attestry/sdk",
  "version": "0.8.0",
  "description": "Official TypeScript SDK for the Attestry compliance kernel — generate and offline-verify sealed EU AI Act Annex IV technical files, submit AI incidents, fetch decision records, and run CI/CD compliance gates.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attestry-ai/attestry-sdk.git",
    "directory": "packages/attestry-sdk"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./annex-iv-verify": {
      "types": "./dist/annex-iv-verify/index.d.ts",
      "default": "./dist/annex-iv-verify/index.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#annex-iv-verify/zlib": {
      "types": "./dist/annex-iv-verify/zlib-node.d.ts",
      "node": "./dist/annex-iv-verify/zlib-node.js",
      "default": "./dist/annex-iv-verify/zlib-portable.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "attestry",
    "ai-compliance",
    "eu-ai-act",
    "colorado-ai-act",
    "nist-ai-rmf",
    "iso-42001",
    "ai-incidents",
    "compliance-sdk"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "canonicalize": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
