{
  "name": "@attestry/otel-agent-compliance",
  "version": "0.2.0",
  "description": "OpenTelemetry SpanProcessor that emits Attestry ABDR records for compliance record-keeping",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attestry-ai/attestry-sdk.git",
    "directory": "packages/otel-agent-compliance"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:otel-compat": "node scripts/otel-compat.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
